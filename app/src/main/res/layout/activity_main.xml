<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_canvas"
    android:orientation="vertical">

    <!-- PHẦN VUỐT TRANG VIEWPAGER2 (CHIẾM TOÀN BỘ PHÍA TRÊN) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- THANH MENU 4 NÚT CỐ ĐỊNH Ở DƯỚI ĐÁY (GIỮ NGUYÊN) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_bottom_nav"
        android:elevation="@dimen/home_dp_12"
        android:orientation="horizontal"
        android:paddingTop="@dimen/home_dp_8"
        android:paddingBottom="@dimen/home_dp_10">

        <!-- Tab 0: Trang chủ -->
        <LinearLayout
            android:id="@+id/navHome"
            style="@style/HomeNavigationItem"
            android:contentDescription="@string/home_tab_home">
            <View android:id="@+id/indicatorHome" style="@style/HomeNavigationIndicator" android:visibility="visible" />
            <ImageView android:id="@+id/iconHome" style="@style/HomeNavigationIcon" android:src="@drawable/ic_home_house" app:tint="@color/smash_primary" />
            <TextView android:id="@+id/labelHome" style="@style/HomeNavigationLabel" android:text="@string/home_tab_home" android:textColor="@color/smash_primary" android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 1: Tìm sân -->
        <LinearLayout
            android:id="@+id/navSearch"
            style="@style/HomeNavigationItem"
            android:contentDescription="@string/home_tab_search">
            <View android:id="@+id/indicatorSearch" style="@style/HomeNavigationIndicator" android:visibility="invisible" />
            <ImageView android:id="@+id/iconSearch" style="@style/HomeNavigationIcon" android:src="@drawable/ic_court_search" app:tint="@color/home_ink" />
            <TextView android:id="@+id/labelSearch" style="@style/HomeNavigationLabel" android:text="@string/home_tab_search" android:textColor="@color/home_muted" />
        </LinearLayout>

        <!-- Tab 2: Lịch đặt -->
        <LinearLayout
            android:id="@+id/navBookings"
            style="@style/HomeNavigationItem"
            android:contentDescription="@string/home_tab_bookings">
            <View android:id="@+id/indicatorBookings" style="@style/HomeNavigationIndicator" android:visibility="invisible" />
            <ImageView android:id="@+id/iconBookings" style="@style/HomeNavigationIcon" android:src="@drawable/ic_court_calendar" app:tint="@color/home_ink" />
            <TextView android:id="@+id/labelBookings" style="@style/HomeNavigationLabel" android:text="@string/home_tab_bookings" android:textColor="@color/home_muted" />
        </LinearLayout>

        <!-- Tab 3: Cá nhân -->
        <LinearLayout
            android:id="@+id/navProfile"
            style="@style/HomeNavigationItem"
            android:contentDescription="@string/home_tab_profile">
            <View android:id="@+id/indicatorProfile" style="@style/HomeNavigationIndicator" android:visibility="invisible" />
            <ImageView android:id="@+id/iconProfile" style="@style/HomeNavigationIcon" android:src="@drawable/ic_person" app:tint="@color/home_ink" />
            <TextView android:id="@+id/labelProfile" style="@style/HomeNavigationLabel" android:text="@string/home_tab_profile" android:textColor="@color/home_muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>