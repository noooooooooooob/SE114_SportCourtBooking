<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_canvas"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_dp_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/home_dp_24"
            android:paddingTop="@dimen/home_dp_18"
            android:paddingEnd="@dimen/home_dp_24"
            android:paddingBottom="@dimen/home_dp_28">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_dp_56">

                <ImageButton
                    android:id="@+id/btnNotifications"
                    android:layout_width="@dimen/home_dp_48"
                    android:layout_height="@dimen/home_dp_48"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_notifications"
                    android:padding="@dimen/home_dp_11"
                    android:src="@drawable/ic_home_bell"
                    app:tint="@color/home_ink" />

                <View
                    android:layout_width="@dimen/home_dp_9"
                    android:layout_height="@dimen/home_dp_9"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="@dimen/home_dp_6"
                    android:layout_marginEnd="@dimen/home_dp_7"
                    android:background="@drawable/bg_home_notification_dot" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_dp_10"
                android:text="@string/home_greeting"
                android:textColor="@color/home_ink"
                android:textSize="@dimen/home_sp_28"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_dp_4"
                android:text="@string/home_greeting_subtitle"
                android:textColor="@color/home_muted"
                android:textSize="@dimen/home_sp_17" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_dp_56"
                android:layout_marginTop="@dimen/home_dp_22"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/home_dp_24"
                app:cardElevation="@dimen/home_dp_0"
                app:strokeColor="@color/home_stroke"
                app:strokeWidth="@dimen/home_dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/home_dp_16"
                    android:paddingEnd="@dimen/home_dp_16">

                    <ImageView
                        android:layout_width="@dimen/home_dp_24"
                        android:layout_height="@dimen/home_dp_24"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_court_search"
                        app:tint="@color/home_muted" />

                    <EditText
                        android:id="@+id/etHomeSearch"
                        android:layout_width="@dimen/home_dp_0"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/home_dp_16"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/home_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapWords"
                        android:singleLine="true"
                        android:textColor="@color/home_ink"
                        android:textColorHint="@color/home_hint"
                        android:textSize="@dimen/home_sp_16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MainActivity stacks this search row when its measured width is under 344dp. -->
            <LinearLayout
                android:id="@+id/homeFilterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_dp_14"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/homeFilterSelection"
                    android:layout_width="@dimen/home_dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/home_dp_28"
                    app:cardElevation="@dimen/home_dp_0"
                    app:strokeColor="@color/home_stroke"
                    app:strokeWidth="@dimen/home_dp_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/home_dp_10">

                        <LinearLayout
                            android:id="@+id/btnChooseDate"
                            android:layout_width="@dimen/home_dp_0"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="@dimen/home_dp_20"
                                android:layout_height="@dimen/home_dp_20"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_court_calendar"
                                app:tint="@color/home_ink" />

                            <TextView
                                android:id="@+id/tvHomeDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/home_dp_7"
                                android:text="@string/home_today"
                                android:textColor="@color/home_ink"
                                android:textSize="@dimen/home_sp_14" />

                            <ImageView
                                android:layout_width="@dimen/home_dp_16"
                                android:layout_height="@dimen/home_dp_16"
                                android:layout_marginStart="@dimen/home_dp_5"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_court_down"
                                app:tint="@color/home_ink" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/home_dp_1"
                            android:layout_height="@dimen/home_dp_28"
                            android:background="@color/home_stroke" />

                        <LinearLayout
                            android:id="@+id/btnChooseDistrict"
                            android:layout_width="@dimen/home_dp_0"
                            android:layout_height="match_parent"
                            android:layout_weight="1.1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="@dimen/home_dp_20"
                                android:layout_height="@dimen/home_dp_20"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_court_pin"
                                app:tint="@color/home_ink" />

                            <TextView
                                android:id="@+id/tvHomeDistrict"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/home_dp_6"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/home_default_district"
                                android:textColor="@color/home_ink"
                                android:textSize="@dimen/home_sp_14" />

                            <ImageView
                                android:layout_width="@dimen/home_dp_16"
                                android:layout_height="@dimen/home_dp_16"
                                android:layout_marginStart="@dimen/home_dp_4"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_court_down"
                                app:tint="@color/home_ink" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFindCourts"
                    android:layout_width="@dimen/home_dp_104"
                    android:layout_height="@dimen/home_dp_56"
                    android:layout_marginStart="@dimen/home_dp_10"
                    android:text="@string/home_find_courts"
                    android:textAllCaps="false"
                    android:textSize="@dimen/home_sp_15"
                    android:textStyle="bold"
                    app:backgroundTint="@color/smash_primary"
                    app:cornerRadius="@dimen/home_dp_26"
                    app:elevation="@dimen/home_dp_0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_dp_30"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/home_dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_featured_title"
                    android:textColor="@color/home_ink"
                    android:textSize="@dimen/home_sp_20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:drawableEnd="@drawable/ic_court_next"
                    android:drawablePadding="@dimen/home_dp_4"
                    android:gravity="center_vertical"
                    android:padding="@dimen/home_dp_4"
                    android:text="@string/home_see_more"
                    android:textColor="@color/smash_primary"
                    android:textSize="@dimen/home_sp_14" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/featuredCourts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_dp_12"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/home_dp_4" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
