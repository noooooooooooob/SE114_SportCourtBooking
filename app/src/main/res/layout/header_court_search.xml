<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="@string/court_search_title"
        android:textColor="@color/court_ink"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="3dp"
        android:text="@string/court_search_subtitle"
        android:textColor="@color/court_muted"
        android:textSize="15sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/court_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCourtName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_court_query"
                android:drawableStart="@drawable/ic_court_search"
                android:drawablePadding="10dp"
                android:hint="@string/court_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/court_ink"
                android:textColorHint="@color/court_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDate"
                    style="@style/Widget.Smash.CourtPill"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1.14"
                    android:drawableEnd="@drawable/ic_court_down"
                    android:drawableStart="@drawable/ic_court_calendar"
                    android:paddingHorizontal="7dp"
                    android:text="@string/court_search_date" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDistrict"
                    style="@style/Widget.Smash.CourtPill"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/ic_court_down"
                    android:drawableStart="@drawable/ic_court_pin"
                    android:paddingHorizontal="7dp"
                    android:text="@string/court_search_district" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="5dp"
                    android:text="@string/court_search_action"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/court_action"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFilters"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_court_filter"
            android:drawablePadding="10dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="@string/court_search_filters"
            android:textAllCaps="false"
            android:textColor="@color/court_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSort"
            style="@style/Widget.Smash.CourtPill"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:drawableEnd="@drawable/ic_court_down"
            android:drawablePadding="8dp"
            android:paddingHorizontal="14dp"
            android:text="@string/court_search_sort_name" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_court_price"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/court_accent" />

        <TextView
            android:id="@+id/stateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/court_search_loading"
            android:textColor="@color/court_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/court_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/court_search_retry"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
