<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom button style for consistent UI -->
    <style name="Widget.Smash.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:backgroundTint">@color/smash_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="HomeNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="HomeNavigationIndicator">
        <item name="android:layout_width">@dimen/home_dp_52</item>
        <item name="android:layout_height">@dimen/home_dp_3</item>
        <item name="android:layout_marginBottom">@dimen/home_dp_5</item>
        <item name="android:background">@drawable/bg_home_nav_indicator</item>
    </style>

    <style name="HomeNavigationIcon">
        <item name="android:layout_width">@dimen/home_dp_26</item>
        <item name="android:layout_height">@dimen/home_dp_26</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="HomeNavigationLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/home_dp_4</item>
        <item name="android:textSize">@dimen/home_sp_12</item>
    </style>
</resources>
