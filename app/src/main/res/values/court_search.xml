    <style name="Theme.Smash.CourtSearch" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/court_accent</item>
        <item name="colorOnSurface">@color/court_ink</item>
        <item name="android:windowBackground">@color/court_background</item>
    </style>

    <style name="Widget.Smash.CourtPill" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_court_pill</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/court_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

